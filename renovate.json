{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "dependencyDashboardAutoclose": true,
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":approveMajorUpdates",
    ":semanticCommits",
    "helpers:pinGitHubActionDigests"
  ],
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "Require manual review before merging dependency updates",
      "matchPackageNames": ["*"],
      "automerge": false
    },
    {
      "matchUpdateTypes": ["major"],
      "reviewers": ["ponharu"]
    }
  ],
  "rangeStrategy": "pin",
  "schedule": ["after 10pm every weekday", "before 3am every weekday"],
  "separateMultipleMajor": true,
  "timezone": "Asia/Tokyo",
  "minimumReleaseAge": "7 days",
  "vulnerabilityAlerts": {
    "enabled": true,
    "minimumReleaseAge": "0 days",
    "dependencyDashboardApproval": false,
    "automerge": false
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 4am on monday"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^src\\/adapters\\.ts$/"],
      "matchStrings": [
        "package:\\s*\"(?<depName>@[^\"@]+/[^\"@]+)@(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "datasourceTemplate": "npm"
    }
  ]
}
